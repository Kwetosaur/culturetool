---
/*
  L'Explosion de la Toungouska — seizième mystère de la série. Structure
  imposée par docs/plans/plan-serie-mysteres.md : 7 sections, badge de
  verdict.

  Point de vigilance : contrairement à d'autres mystères de la série
  impliquant des victimes réelles, la Toungouska n'a fait aucune victime
  humaine confirmée grâce à l'extrême isolement de la région — le ton peut
  donc rester scientifique sans la sobriété funèbre requise ailleurs
  (Dyatlov, Somerton Man), tout en respectant les Evenks qui habitaient la
  zone.

  Effets : data-egg="toungouska" + data-scroll-fx="toungouskaOnde" sur
  #enigme — une onde qui traverse l'écran et couche des troncs en éventail,
  sans flash ni explosion spectaculaire.
*/
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import VerdictBadge from '../components/VerdictBadge.astro';
import InfoCard from '../components/InfoCard.astro';
import FigureCard from '../components/FigureCard.astro';
import MiniCard from '../components/MiniCard.astro';
import Timeline from '../components/Timeline.astro';
import TheoryCard from '../components/TheoryCard.astro';
import ScienceBlock from '../components/ScienceBlock.astro';
import HeritageBlock from '../components/HeritageBlock.astro';
import CautionBox from '../components/CautionBox.astro';
import Sources from '../components/Sources.astro';

/* Taïga sibérienne, onde de choc ocre, aube prolongée : la matière de
   l'événement plutôt qu'une palette "explosion" générique. */
const palette = {
  bg: '#14181a',
  'bg-deep': '#0a0d0e',
  surface: '#1e2426',
  'surface-alt': '#282f32',
  border: '#4a5658',
  ink: '#eef2f2',
  text: '#c8d4d4',
  'text-dim': '#84989a',
  accent: '#8a9a5a',
  'accent-bright': '#b0c47e',
  accent2: '#c9982f',
  'accent2-bright': '#e8c164',
  verdict: '#1e3a6e',
  'verdict-bright': '#3a5a9a',
  glow: 'rgba(138,154,90,0.22)',
};

const SECTIONS = [
  { id: 'contexte', nav: 'Contexte' },
  { id: 'enigme', nav: 'Énigme' },
  { id: 'decouverte', nav: 'Découverte' },
  { id: 'culture-populaire', nav: 'Culture pop' },
  { id: 'science', nav: 'Science' },
  { id: 'theories', nav: 'Théories' },
  { id: 'heritage', nav: 'Héritage' },
];
---
<PageLayout
  title="L'Explosion de la Toungouska"
  serie="Grands Mystères du Monde"
  description="Le 30 juin 1908, une explosion aérienne d'environ 10 à 15 mégatonnes couche 80 millions d'arbres sur plus de 2000 km² de taïga sibérienne — sans laisser le moindre cratère. Le consensus scientifique penche pour un astéroïde rocheux désintégré en vol, mais sa composition et sa taille exactes restent débattues faute de fragment retrouvé."
  href="mystere-toungouska.html"
  egg="toungouska"
  palette={palette}
  sections={SECTIONS}
  epigraph="SIBÉRIE · 30 JUIN 1908"
  nextUp="Prochain chapitre de la série « Grands Mystères du Monde » : à déterminer"
>
  <p class="subtitle" slot="hero">Une explosion de 15 mégatonnes, et pas un seul cratère</p>
  <p class="tagline" slot="hero">
    Quatre-vingts millions d'arbres couchés en éventail sur plus de deux mille kilomètres
    carrés de taïga, une onde enregistrée à travers toute l'Eurasie — et pourtant, presque
    vingt ans de silence avant qu'une première expédition scientifique n'atteigne enfin le lieu.
  </p>
  <VerdictBadge
    slot="hero"
    label="Verdict"
    text="Largement expliqué par la science (explosion aérienne d'un corps céleste), composition et taille exactes encore débattues"
    note="Le consensus scientifique retient l'explosion en altitude d'un objet céleste rocheux d'environ 50 à 60 mètres, désintégré avant l'impact — ce qui explique l'absence de cratère. Aucune trace matérielle de l'objet n'ayant été retrouvée, sa composition exacte (astéroïde ou comète) reste un point de débat actif."
  />

  <Section id="contexte" label="Ce qui est établi" title="Un désastre sans précédent, sans victime confirmée" intro="Avant d'aborder ce qui reste débattu, ce qui ne fait aucun doute : l'ampleur physique de l'événement et son enregistrement instrumental à travers toute l'Eurasie.">
    <div class="card-grid">
      <InfoCard num="I" title="80 millions d'arbres couchés" sub="Plus de 2000 km²" body="La forêt est abattue selon un motif radial caractéristique d'une onde de choc venue d'en haut, centré sur un point sans aucun cratère associé." />
      <InfoCard num="II" title="Une énergie de 10 à 15 mégatonnes" sub="Estimation par modélisation" body="Une puissance comparable à une grande bombe thermonucléaire, environ mille fois l'explosion d'Hiroshima — évaluée a posteriori par la surface de dévastation et les ondes sismiques enregistrées." />
      <InfoCard num="III" title="Une onde détectée à travers l'Eurasie" sub="Stations sismiques et baromètres" body="Des stations sismiques et barométriques aussi lointaines que l'Angleterre enregistrent le passage de l'onde de choc ; des ciels nocturnes anormalement lumineux sont rapportés dans toute l'Europe et l'Asie durant plusieurs jours." />
    </div>
  </Section>

  <Section id="enigme" label="Ce qui reste à expliquer" title="Pourquoi aucun cratère, et de quoi était fait l'objet ?" scrollFx="toungouskaOnde" intro="L'absence totale de cratère et de fragment matériel retrouvé, malgré des décennies de recherches, laisse ouvertes deux questions précises.">
    <div class="card-grid wide">
      <FigureCard name="Aucun cratère d'impact" role="Fait déroutant central" tags={['Airburst', 'Sans équivalent au sol']} body="Une explosion de cette ampleur laisse généralement un cratère si l'objet touche le sol ; son absence totale suggère fortement une explosion en altitude (airburst) plutôt qu'un impact direct — un scénario confirmé depuis par l'événement de moindre ampleur de Tcheliabinsk en 2013." />
      <FigureCard name="Aucun fragment matériel retrouvé" role="Obstacle à l'identification" tags={['Composition inconnue', 'Recherches infructueuses']} body="Malgré des décennies de recherche de micro-fragments et de traces chimiques dans les sols et les résines d'arbres de la région, aucun débris météoritique indiscutable n'a permis de trancher entre un astéroïde rocheux et un noyau cométaire glacé." />
      <FigureCard name="Une expédition retardée de près de vingt ans" role="Contexte historique" tags={['Révolution russe', 'Guerre civile']} body="La Révolution russe puis la guerre civile retardent toute expédition scientifique sérieuse jusqu'en 1927, presque deux décennies après les faits, compliquant d'autant la collecte de preuves fraîches." />
    </div>
  </Section>

  <Section id="decouverte" label="Comment on l'a étudié" title="De l'expédition Kulik à la modélisation moderne">
    <Timeline items={[
      { year: '30 juin 1908', title: 'L\'explosion', body: "Vers 7h17 heure locale, une explosion aérienne dévaste la région de la rivière Podkamennaya Toungouska, en Sibérie centrale." },
      { year: '1908', title: 'Rapports de témoins evenks et de voyageurs', body: "Des éleveurs evenks de rennes et des passagers du chemin de fer Transsibérien, à des centaines de kilomètres, rapportent le bruit, l'onde de choc et une lumière intense." },
      { year: '1921-1927', title: 'Première expédition de Leonid Kulik', body: "Le minéralogiste soviétique atteint enfin la zone en 1927, découvrant l'étendue de la forêt couchée en éventail, mais aucun cratère ni fragment météoritique." },
      { year: 'Années 1930-1950', title: 'Expéditions soviétiques successives', body: "De nouvelles campagnes cherchent en vain des débris métalliques ou des traces chimiques distinctives dans les sols de la région." },
      { year: '1958-1961', title: 'Analyses des microparticules de résine', body: "Des chercheurs identifient dans la résine d'arbres de l'époque des microparticules dont la composition alimente le débat entre origine cométaire et astéroïdale." },
      { year: '2013', title: 'L\'événement de Tcheliabinsk', body: "Un bolide bien plus petit explose au-dessus d'une autre région de Russie, entièrement filmé par des caméras embarquées modernes — un cas d'école qui aide à calibrer la physique des explosions aériennes comparables." },
      { year: 'Années 2010-2020', title: 'Modélisations informatiques affinées', body: "Des simulations numériques modernes précisent les hypothèses de taille (environ 50-60 mètres) et de trajectoire de l'objet, sans clore définitivement le débat sur sa composition." },
    ]} />
  </Section>

  <Section id="culture-populaire" label="D'un fait divers sibérien à un symbole de défense planétaire" title="Comment la Toungouska est devenue une référence mondiale">
    <div class="card-grid compact">
      <MiniCard title="La théorie du « rayon de la mort » de Tesla" tag="Rumeur populaire non fondée" body="Une théorie largement diffusée en ligne attribue l'explosion à une expérience ratée de Nikola Tesla à la tour de Wardenclyffe — une affirmation sans preuve sérieuse et difficilement compatible avec la chronologie réelle des expériences de Tesla." />
      <MiniCard title="Un sujet récurrent de fiction et de documentaires" tag="Culture populaire" body="L'événement inspire régulièrement romans de science-fiction, jeux vidéo et documentaires scientifiques, souvent aux côtés d'hypothèses extraterrestres non étayées." />
      <MiniCard title="La Journée internationale des astéroïdes" tag="ONU, depuis 2016" body="L'Assemblée générale des Nations unies fixe cette journée de sensibilisation à la défense planétaire au 30 juin, en référence directe à l'anniversaire de l'explosion." />
    </div>
  </Section>

  <Section id="science" label="Section pivot" title="Ce qu'on peut affirmer">
    <ScienceBlock num="Enquête 1" title="Une explosion aérienne, pas un impact au sol" body="L'absence totale de cratère, combinée au motif radial de la dévastation forestière, constitue un faisceau de preuves solide en faveur d'une désintégration de l'objet en altitude plutôt que d'un impact direct — un mécanisme depuis confirmé à plus petite échelle par l'événement de Tcheliabinsk en 2013." />
    <ScienceBlock num="Enquête 2" title="Une taille estimée, une composition toujours débattue" body="Les modélisations convergent vers un objet d'environ 50 à 60 mètres de diamètre, mais l'absence de fragment matériel indiscutable empêche de trancher fermement entre un astéroïde rocheux et un noyau cométaire glacé, plus susceptible de se désintégrer entièrement sans laisser de trace." />
    <ScienceBlock num="Enquête 3" title="Aucune victime humaine confirmée, une région heureusement peu peuplée" body="Grâce à l'extrême isolement de la région, aucun décès humain n'a été formellement documenté, même si des témoignages evenks rapportent des troupeaux de rennes tués et des installations endommagées — un désastre écologique majeur, mais pas la catastrophe humaine qu'un événement comparable aurait causé en zone habitée." />
  </Section>

  <Section id="theories" label="Panorama équitable" title="Ce que chaque théorie vaut vraiment">
    <TheoryCard
      title="Un astéroïde rocheux désintégré en vol"
      level="consensus"
      status="Position dominante"
      body="La majorité des astronomes et planétologues retiennent l'hypothèse d'un astéroïde rocheux d'une cinquantaine de mètres, entré dans l'atmosphère à grande vitesse et désintégré par la pression avant de toucher le sol."
      attrib="Consensus dominant en planétologie"
    />
    <TheoryCard
      title="Un fragment cométaire glacé"
      level="plausible"
      status="Hypothèse concurrente sérieuse"
      body="Une minorité significative de chercheurs privilégie un noyau cométaire, dont la composition glacée expliquerait plus facilement l'absence totale de débris matériels retrouvés au sol."
      attrib="Hypothèse minoritaire mais toujours défendue en planétologie"
    />
    <TheoryCard
      title="Une expérience secrète, une arme ou un vaisseau extraterrestre"
      level="folklore"
      status="Écarté"
      body="Les théories évoquant une arme expérimentale, un vaisseau spatial ou un trou noir traversant la Terre ne reposent sur aucune preuve matérielle sérieuse et sont rejetées par la quasi-totalité de la communauté scientifique." />
  </Section>

  <Section id="heritage" label="Aujourd'hui" title="Ce que cet événement fait encore">
    <HeritageBlock title="Un cas d'école de la défense planétaire" body="La Toungouska reste la référence la plus citée pour illustrer les dégâts qu'un astéroïde de taille moyenne pourrait causer, et sert d'argument central aux programmes internationaux de détection d'objets géocroiseurs." />
    <HeritageBlock title="Un site d'étude scientifique toujours actif" body="Des expéditions et analyses de sol continuent d'être menées dans la région pour affiner la compréhension de la composition exacte de l'objet." />
    <HeritageBlock title="Une reconnaissance officielle internationale" body="La Journée internationale des astéroïdes de l'ONU perpétue chaque 30 juin la mémoire scientifique de l'événement à l'échelle mondiale." />
    <CautionBox>
      La région touchée était habitée par des éleveurs evenks de rennes, dont les témoignages
      directs — troupeaux tués, installations détruites — comptent parmi les sources les plus
      précieuses sur l'événement. Les récupérer sans les créditer comme une simple couleur
      locale anecdotique serait injuste envers les premiers témoins réels de la catastrophe.
    </CautionBox>
  </Section>

  <Sources items={[
    { label: "Leonid Kulik, rapports d'expédition de l'Académie des sciences de l'URSS, 1927-1930 (synthétisés dans l'historiographie scientifique ultérieure)", note: "Source des premières observations de terrain citées en #decouverte." },
    { label: "Christopher Chyba, Paul Thomas, Kevin Zahnle, \"The 1908 Tunguska explosion: atmospheric disruption of a stony asteroid\", Nature, vol. 361, 1993", url: "https://doi.org/10.1038/361040a0", note: "Étude de référence sur l'hypothèse de l'astéroïde rocheux désintégré en vol, citée en #science et #theories." },
    { label: "NASA, \"Tunguska Event\", NASA Science - Solar System Exploration", url: "https://science.nasa.gov/solar-system/asteroids/", note: "Synthèse de référence sur l'ampleur et les estimations modernes de l'événement citées en #contexte et #science." },
    { label: "Assemblée générale des Nations unies, résolution A/RES/71/90, \"International cooperation in the peaceful uses of outer space\", 2016", note: "Source de la Journée internationale des astéroïdes citée en #heritage." },
  ]} />
</PageLayout>
