---
/*
  Mythologie Polynésienne — dix-neuvième mythologie de la série. Structure
  imposée par docs/plans/plan-serie-mythologies.md : 9 sections fixes.

  Distincte de culture-polynesie.html (angle navigation/civilisationnel,
  déjà publié) : ici, panthéon et cosmogonie. Le geste de l'hameçon qui
  tire une île hors de l'eau est déjà pris par objet-hamecon-maui.astro —
  cette page choisit donc un autre angle pour son effet (la séquence
  cosmogonique Te Kore / Te Pō / Te Ao Mārama) pour ne pas répéter le même
  geste sur deux pages différentes.

  #royaumes utilise la séquence cosmologique māorie authentique (Te Kore,
  Te Pō, Te Ao Mārama) plutôt qu'un empilement calqué sur un autre
  chapitre (correctif du 26/07/2026). Panthéon volontairement présenté
  nation par nation (māori, hawaïen, tahitien) plutôt que fondu en un
  seul panthéon unifié, pour ne pas effacer les traditions distinctes
  réparties sur un triangle océanique immense.

  Effets : data-egg="mauihook" + data-scroll-fx="teAoMarama" sur
  #pantheon — la nuit primordiale qui se déchire pour révéler la lumière.
  Déchiffrement des titres : glyphs="polynesienne", pool symbolique
  abstrait (triangle, losange), pas une écriture réelle — le rongorongo
  de l'île de Pâques, seule véritable écriture polynésienne attestée,
  reste réservé à sa propre page dans la série mystères.
*/
import PageLayout from '../layouts/PageLayout.astro';
import Section from '../components/Section.astro';
import InfoCard from '../components/InfoCard.astro';
import FigureCard from '../components/FigureCard.astro';
import MiniCard from '../components/MiniCard.astro';
import StoryBlock from '../components/StoryBlock.astro';
import Timeline from '../components/Timeline.astro';
import HeritageBlock from '../components/HeritageBlock.astro';
import CautionBox from '../components/CautionBox.astro';
import Decode from '../components/Decode.astro';
import Sources from '../components/Sources.astro';

/* Nuit océanique, corail rougeoyant, lave de Pele : la matière du
   triangle polynésien plutôt qu'une reprise du bleu déjà pris par
   culture-polynesie.html. */
const palette = {
  bg: '#0a1a1c',
  'bg-deep': '#061012',
  surface: '#12282a',
  'surface-alt': '#1a3638',
  border: '#2e5c5c',
  ink: '#eef7f4',
  text: '#c8e0dc',
  'text-dim': '#7fa8a0',
  accent: '#e8925a',
  'accent-bright': '#f7b080',
  accent2: '#2e8a6a',
  'accent2-bright': '#4fc094',
  verdict: '#7a3a20',
  'verdict-bright': '#a85a35',
  glow: 'rgba(232,146,90,0.20)',
};

const SECTIONS = [
  { id: 'royaumes', nav: 'Cosmogonie' },
  { id: 'pantheon', nav: 'Panthéon' },
  { id: 'genealogie', nav: 'Maisons' },
  { id: 'creatures', nav: 'Êtres' },
  { id: 'legendes', nav: 'Légendes' },
  { id: 'anecdotes', nav: 'Anecdotes' },
  { id: 'monde', nav: 'Monde' },
  { id: 'frise', nav: 'Frise' },
  { id: 'heritage', nav: 'Héritage' },
];

const royaumes = [
  { num: 'I', title: 'Te Kore', sub: 'Le vide potentiel', body: "Pas un néant absolu mais un état de potentialité pure, d'où tout pourra naître — le point de départ de la généalogie cosmique māorie (whakapapa)." },
  { num: 'II', title: 'Te Pō', sub: 'La nuit, la gestation', body: "Longue succession de nuits pendant lesquelles les atua (forces et divinités) prennent forme dans l'obscurité, avant toute apparition de lumière." },
  { num: 'III', title: 'Te Ao Mārama', sub: 'Le monde de lumière', body: "Notre monde actuel, né de la séparation de Ranginui (le ciel) et Papatūānuku (la terre) par leurs propres enfants — le seul des trois états où la lumière existe." },
];
---
<PageLayout
  title="Mythologie Polynésienne"
  serie="Mythologies du Monde"
  description="Du vide primordial à la lumière du monde en trois étapes, un couple de parents cosmiques séparés par leurs propres enfants, et Maui, demi-dieu qui pêche des îles et vole le feu — une cosmologie partagée, sous des formes distinctes, à travers l'immense triangle océanique de la Polynésie."
  href="mythologie-polynesienne.html"
  egg="mauihook"
  palette={palette}
  sections={SECTIONS}
  epigraph="TE KORE · TE PŌ · TE AO MĀRAMA"
  nextUp="Prochain chapitre de la série « Mythologies du Monde » : <strong>la mythologie cananéenne</strong>"
>
  <p class="subtitle" slot="hero">Tāne · Tangaroa · Maui</p>
  <p class="tagline" slot="hero">
    Une seule séquence cosmologique — du vide à la nuit, de la nuit à la lumière — déclinée
    sous des formes distinctes de Hawaï à la Nouvelle-Zélande, sur le plus vaste espace
    océanique jamais peuplé par une seule famille de traditions.
  </p>

  <Section
    id="royaumes"
    label="Cosmogonie"
    title="De Te Kore à Te Ao Mārama"
    intro="Pas un empilement de royaumes façon Yggdrasil : la cosmologie polynésienne, dans sa version māorie la mieux documentée publiquement, avance par étapes successives — du potentiel pur à la nuit, de la nuit à la lumière.">
    <Fragment slot="title"><Decode glyphs="polynesienne">De Te Kore à Te Ao Mārama</Decode></Fragment>
    <div class="map-diagram">
      <svg viewBox="0 0 400 260" xmlns="http://www.w3.org/2000/svg">
        <rect x="60" y="20" width="280" height="50" fill="none" stroke="#7fa8a0" stroke-width="2"/>
        <text x="200" y="50" text-anchor="middle" fill="#7fa8a0" font-family="Cinzel, serif" font-size="13">TE KORE</text>
        <line x1="200" y1="70" x2="200" y2="100" stroke="#4fc094" stroke-width="2" stroke-dasharray="4 4"/>
        <rect x="40" y="100" width="320" height="55" fill="#12282a" stroke="#2e5c5c" stroke-width="2"/>
        <text x="200" y="132" text-anchor="middle" fill="#c8e0dc" font-family="Cinzel, serif" font-size="14">TE PŌ</text>
        <line x1="200" y1="155" x2="200" y2="185" stroke="#f7b080" stroke-width="2" stroke-dasharray="4 4"/>
        <rect x="20" y="185" width="360" height="60" fill="#e8925a" opacity="0.85"/>
        <text x="200" y="220" text-anchor="middle" fill="#0a1a1c" font-family="Cinzel, serif" font-size="15" font-weight="700">TE AO MĀRAMA</text>
      </svg>
    </div>
    <p class="map-caption">Trois états successifs, pas trois lieux distincts — la lumière n'existe que dans le dernier.</p>
    <div class="card-grid compact">
      {royaumes.map((r) => <InfoCard {...r} />)}
    </div>
  </Section>

  <Section id="pantheon" label="~13 figures majeures" title="Le panthéon du triangle océanique" scrollFx="teAoMarama">
    <Fragment slot="title"><Decode glyphs="polynesienne">Le panthéon du triangle océanique</Decode></Fragment>
    <div class="card-grid wide">
      <FigureCard name="Ranginui" role="Père-Ciel" tags={['Māori', 'Séparation primordiale']} body="Uni à Papatūānuku dans une étreinte si étroite que leurs enfants vivent dans l'obscurité totale, jusqu'à ce que ceux-ci décident de les séparer de force." />
      <FigureCard name="Papatūānuku" role="Mère-Terre" tags={['Māori', 'Fertilité']} body="Toujours pleurée par Ranginui séparé d'elle — la pluie serait, selon la tradition, les larmes du père-ciel qui continue de lui manquer." />
      <FigureCard name="Tāne" role="Dieu des forêts et de la lumière" tags={['Māori', 'Artisan de la séparation']} body="Pousse ses parents l'un loin de l'autre avec ses jambes plutôt qu'avec ses bras, libérant la lumière — puis peuple la terre nouvellement éclairée de forêts et d'oiseaux." />
      <FigureCard name="Tangaroa / Kanaloa" role="Dieu de l'océan" tags={['Pan-polynésien']} body="Figure océanique majeure sous des noms apparentés dans presque toutes les traditions polynésiennes, gardien des créatures marines et des grandes profondeurs." />
      <FigureCard name="Tāwhirimātea" role="Dieu des tempêtes" tags={['Māori', 'Seul dissident']} body="Seul des enfants à s'opposer à la séparation de ses parents, il déchaîne depuis lors vents et tempêtes contre ses frères en signe de colère persistante." />
      <FigureCard name="Maui" role="Demi-dieu filou et bienfaiteur" tags={['Pan-polynésien', 'Héros culturel']} body="Pêche des îles entières hors de l'océan, ralentit la course du soleil en le domptant, et vole le secret du feu pour les humains — un héros culturel partagé, avec variations, de Hawaï à la Nouvelle-Zélande." />
      <FigureCard name="Pele" role="Déesse des volcans" tags={['Hawaï']} body="Habite le volcan Kīlauea et continue, dans la tradition hawaïenne vivante, d'être associée directement à chaque éruption volcanique observée sur la Grande Île." />
      <FigureCard name="Hina" role="Déesse lunaire aux visages multiples" tags={['Pan-polynésien']} body="Figure féminine majeure dont le rôle exact — lune, tissage, protection, artisanat — varie sensiblement d'une tradition insulaire à l'autre, sans version unique qui ferait autorité." />
      <FigureCard name="Rongo / Lono" role="Dieu de l'agriculture et de la paix" tags={['Māori et hawaïen']} body="Associé aux récoltes et aux périodes de paix rituelle ; sa fête hawaïenne annuelle, le Makahiki, structure encore aujourd'hui une part du calendrier culturel local." />
      <FigureCard name="Tū / Kū" role="Dieu de la guerre" tags={['Māori et hawaïen']} body="Figure opposée à Rongo dans l'équilibre rituel entre guerre et paix, invoquée avant les conflits dans plusieurs traditions insulaires." />
      <FigureCard name="Hine-nui-te-pō" role="Déesse de la mort" tags={['Māori']} body="Garde le seuil du monde des morts ; c'est en tentant de la traverser pour voler l'immortalité que Maui trouve la mort, tué par le rire d'un oiseau qui la réveille au mauvais moment." />
      <FigureCard name="Nāmaka" role="Déesse de la mer, sœur de Pele" tags={['Hawaï']} body="Rivale de sa propre sœur dans plusieurs récits hawaïens, incarnant la tension mythologique entre le feu volcanique et l'eau océanique." />
      <FigureCard name="Hiro" role="Dieu-navigateur" tags={['Tahiti']} body="Figure tahitienne associée à la navigation et au vol, dont le nom se retrouve, sous des formes apparentées, dans plusieurs traditions du Pacifique central." />
    </div>
  </Section>

  <Section
    id="genealogie"
    label="3 maisons, pas un panthéon unifié"
    title="Ranginui, Tāne et les enfants dissidents"
    intro="Pas un arbre unique fondant tous les dieux polynésiens en une seule généalogie : la tradition māorie elle-même organise une tension entre trois lignées issues de la séparation de Rangi et Papa.">
    <Fragment slot="title"><Decode glyphs="polynesienne">Ranginui, Tāne et les enfants dissidents</Decode></Fragment>
    <div class="map-diagram">
      <svg viewBox="0 0 600 240" xmlns="http://www.w3.org/2000/svg">
        <text x="100" y="30" text-anchor="middle" fill="#f7b080" font-family="Cinzel, serif" font-size="12">MAISON DE TĀNE</text>
        <circle cx="100" cy="70" r="18" fill="#e8925a"/>
        <text x="100" y="75" text-anchor="middle" font-size="8" fill="#0a1a1c" font-weight="700">Tāne</text>
        <line x1="100" y1="88" x2="100" y2="130" stroke="#e8925a" stroke-width="1" stroke-dasharray="3 4"/>
        <circle cx="100" cy="145" r="13" fill="#1a3638" stroke="#e8925a" stroke-width="1.3"/>
        <text x="100" y="165" text-anchor="middle" font-size="8" fill="#c8e0dc">forêts, oiseaux</text>

        <text x="300" y="30" text-anchor="middle" fill="#4fc094" font-family="Cinzel, serif" font-size="12">MAISON DE TANGAROA</text>
        <circle cx="300" cy="70" r="18" fill="#2e8a6a"/>
        <text x="300" y="75" text-anchor="middle" font-size="8" fill="#eef7f4" font-weight="700">Tangaroa</text>
        <line x1="300" y1="88" x2="300" y2="130" stroke="#4fc094" stroke-width="1" stroke-dasharray="2 4"/>
        <circle cx="300" cy="145" r="13" fill="#1a3638" stroke="#4fc094" stroke-width="1.3"/>
        <text x="300" y="165" text-anchor="middle" font-size="8" fill="#c8e0dc">créatures marines</text>

        <text x="500" y="30" text-anchor="middle" fill="#a85a35" font-family="Cinzel, serif" font-size="12">MAISON DE TĀWHIRIMĀTEA</text>
        <circle cx="500" cy="70" r="18" fill="#7a3a20"/>
        <text x="500" y="75" text-anchor="middle" font-size="8" fill="#f5ecd8" font-weight="700">Tāwhirimātea</text>
        <line x1="500" y1="88" x2="500" y2="130" stroke="#a85a35" stroke-width="1" stroke-dasharray="2 4"/>
        <circle cx="500" cy="145" r="13" fill="#1a3638" stroke="#a85a35" stroke-width="1.3"/>
        <text x="500" y="165" text-anchor="middle" font-size="8" fill="#c8e0dc">vents, tempêtes</text>
      </svg>
    </div>
    <p class="map-caption">Trait plein = filiation directe ; pointillé = domaine confié. Tāwhirimātea reste, seul, en rupture ouverte avec ses frères depuis la séparation.</p>
  </Section>

  <Section id="creatures" label="7 êtres notables" title="Le bestiaire du Pacifique">
    <Fragment slot="title"><Decode glyphs="polynesienne">Le bestiaire du Pacifique</Decode></Fragment>
    <div class="card-grid compact">
      <MiniCard title="Le taniwha" tag="Māori" body="Être surnaturel des eaux, tantôt gardien protecteur d'une communauté, tantôt danger réel selon les lieux et les récits — jamais réductible à un simple monstre unique." />
      <MiniCard title="Les mo'o" tag="Hawaï" body="Esprits-lézards associés aux points d'eau douce, gardiens traditionnels de sources et d'étangs spécifiques." />
      <MiniCard title="Le grand poisson-île" tag="Nouvelle-Zélande" body="Selon la tradition māorie, l'île du Nord de la Nouvelle-Zélande serait elle-même le grand poisson que Maui a hissé hors des flots — Te Ika-a-Māui, « le poisson de Maui »." />
      <MiniCard title="Les requins ancestraux" tag="Hawaï (ʻaumākua)" body="Certaines lignées familiales hawaïennes reconnaissent traditionnellement un requin particulier comme gardien ancestral protecteur, jamais chassé par respect." />
      <MiniCard title="Pouākai" tag="Māori" body="Oiseau géant redouté de la tradition orale, dont certains chercheurs rapprochent le souvenir d'un aigle disparu (l'aigle de Haast), aujourd'hui éteint." />
      <MiniCard title="Ruaumoko" tag="Māori" body="Enfant resté dans le ventre de Papatūānuku lors de la séparation ; ses mouvements y sont traditionnellement associés aux tremblements de terre et à l'activité volcanique." />
      <MiniCard title="L'anguille géante" tag="Récits partagés" body="Créature affrontée par Maui ou par Hina selon les versions, dont la mise à mort explique, dans certaines traditions, l'origine du cocotier." />
    </div>
  </Section>

  <Section id="legendes" label="9 légendes" title="Les grands récits polynésiens">
    <Fragment slot="title"><Decode glyphs="polynesienne">Les grands récits polynésiens</Decode></Fragment>
    <StoryBlock num="Légende I" title="La séparation de Rangi et Papa" body="Étroitement enlacés, Ranginui et Papatūānuku maintiennent leurs enfants dans une obscurité totale entre eux. Après un long débat, Tāne parvient à les écarter en poussant de ses jambes plutôt que de ses bras — la lumière du monde, Te Ao Mārama, naît de ce seul geste." />
    <StoryBlock num="Légende II" title="La révolte de Tāwhirimātea" body="Seul des enfants à s'opposer à la séparation de ses parents, le dieu des tempêtes s'enfuit rejoindre son père au ciel et déchaîne depuis lors vents et ouragans contre ses frères restés sur terre — un mythe qui continue d'expliquer, dans la tradition orale, l'origine des tempêtes." />
    <StoryBlock num="Légende III" title="Maui pêche les îles" body="À l'aide d'un hameçon magique fabriqué à partir de la mâchoire d'une ancêtre, Maui remonte des profondeurs de vastes étendues de terre — selon les traditions locales, l'île du Nord de la Nouvelle-Zélande ou plusieurs îles hawaïennes doivent directement leur existence à cette pêche." />
    <StoryBlock num="Légende IV" title="Maui dompte le soleil" body="Jugeant les jours trop courts, Maui tend un piège au soleil à son lever et le bat jusqu'à ce qu'il accepte de ralentir sa course dans le ciel — un mythe qui explique, dans plusieurs traditions, la durée normale du jour." />
    <StoryBlock num="Légende V" title="Maui vole le feu" body="Descendu voler le secret du feu à une ancêtre gardienne, Maui use de ruse plutôt que de force pour l'obtenir et le rapporter aux hommes — un motif de bienfaiteur culturel qui traverse plusieurs mythologies mondiales sous des formes distinctes." />
    <StoryBlock num="Légende VI" title="La mort de Maui" body="Pour offrir l'immortalité à l'humanité, Maui tente de traverser le corps endormi de Hine-nui-te-pō, déesse de la mort, en entrant par sa bouche pour ressortir par la sienne. Le rire d'un petit oiseau la réveille au mauvais moment ; elle se referme sur lui et le tue — depuis, selon la tradition, les humains restent mortels." quote="Un rire d'oiseau a scellé le sort de toute l'humanité." cite="Résumé d'une version répandue du récit" />
    <StoryBlock num="Légende VII" title="La rivalité de Pele et Nāmaka" body="Sœurs volcanique et océanique, Pele et Nāmaka s'affrontent à travers l'archipel hawaïen — chaque coulée de lave qui rencontre la mer et se fige y est traditionnellement lue comme un nouvel épisode de cette rivalité entre le feu et l'eau." />
    <StoryBlock num="Légende VIII" title="L'origine du cocotier" body="Selon plusieurs traditions insulaires, le premier cocotier naît de la tête enterrée d'une anguille géante vaincue lors d'un affrontement mythique — un récit qui relie directement une ressource vivrière essentielle à un geste fondateur précis." />
    <StoryBlock num="Légende IX" title="Le Makahiki, la trêve de Rongo" body="Chaque année, selon la tradition hawaïenne, le dieu Rongo/Lono revient sur l'archipel pour une période de célébration et de trêve rituelle des combats — un cycle calendaire qui structure encore aujourd'hui certaines commémorations culturelles locales." />
  </Section>

  <Section id="anecdotes" label="7 curiosités" title="Étymologies et distinctions utiles">
    <Fragment slot="title"><Decode glyphs="polynesienne">Étymologies et distinctions utiles</Decode></Fragment>
    <div class="card-grid compact">
      <MiniCard title="Un triangle, pas un pays unique" tag="Échelle géographique" body="Le « triangle polynésien » relie Hawaï, la Nouvelle-Zélande (Aotearoa) et l'île de Pâques (Rapa Nui) — un espace océanique plus vaste que l'Amérique du Nord, peuplé par des traditions apparentées mais distinctes." />
      <MiniCard title="Maui, un nom qui voyage" tag="Variantes régionales" body="Le nom et les récits du demi-dieu changent de forme d'une île à l'autre — Māui-tikitiki-a-Taranga en Nouvelle-Zélande, Māui-a-Kalana à Hawaï — sans qu'aucune version ne fasse autorité unique sur les autres." />
      <MiniCard title="Kanaloa n'est pas toujours Tangaroa" tag="Nuance linguistique" body="Si les deux noms sont apparentés linguistiquement à travers les langues polynésiennes, leurs rôles précis diffèrent parfois sensiblement d'une tradition insulaire à l'autre." />
      <MiniCard title="Le Makahiki, calendrier vivant" tag="Hawaï" body="Cette période rituelle liée à Rongo/Lono continue d'influencer, sous forme adaptée, certaines célébrations culturelles hawaïennes contemporaines." />
      <MiniCard title="Pele, toujours invoquée aujourd'hui" tag="Croyance vivante" body="De nombreux résidents de la Grande Île de Hawaï continuent, lors des éruptions du Kīlauea, d'évoquer directement Pele — une croyance active, pas un folklore éteint." />
      <MiniCard title="Le rongorongo, exception notable" tag="Île de Pâques" body="Contrairement au reste de la tradition orale polynésienne, l'île de Pâques a développé un système d'écriture propre, resté à ce jour non déchiffré — sujet traité séparément dans la série des grands mystères." />
      <MiniCard title="Hawaiki, une origine mythique commune" tag="Mémoire de migration" body="De nombreuses traditions polynésiennes distinctes évoquent une terre d'origine ancestrale commune nommée sous des formes apparentées (Hawaiki, Havaiki, Hawaii) — reflet mythologique probable des grandes migrations historiques réelles à travers le Pacifique." />
    </div>
  </Section>

  <Section id="monde" label="Expansion réelle" title="D'Aotearoa au Kīlauea">
    <Fragment slot="title"><Decode glyphs="polynesienne">D'Aotearoa au Kīlauea</Decode></Fragment>
    <div class="map-diagram">
      <svg viewBox="0 0 500 220" xmlns="http://www.w3.org/2000/svg">
        <circle cx="250" cy="110" r="10" fill="#e8925a"/>
        <text x="250" y="90" text-anchor="middle" fill="#f7b080" font-size="12" font-family="Cinzel, serif">TRIANGLE POLYNÉSIEN</text>
        {[[120,60,'Aotearoa (Nouvelle-Zélande)'],[380,60,'Hawaï — volcan Kīlauea'],[100,170,'Tahiti'],[400,170,'Rapa Nui (île de Pâques)']].map(([x,y,label]) => (
          <g>
            <line x1="250" y1="110" x2={x} y2={y} stroke="#4fc094" stroke-width="1" stroke-dasharray="3 4" opacity="0.6"/>
            <circle cx={x} cy={y} r="6" fill="#1a3638" stroke="#e8925a" stroke-width="1.3"/>
            <text x={x} y={y - 12} text-anchor="middle" fill="#c8e0dc" font-size="10">{label}</text>
          </g>
        ))}
      </svg>
    </div>
    <p class="map-caption">Trois sommets d'un même triangle océanique, chacun porteur d'une variante distincte des mêmes récits fondateurs.</p>
    <div class="card-grid">
      <InfoCard title="Aotearoa / Nouvelle-Zélande" sub="Tradition māorie" body="Foyer de la séquence cosmologique Te Kore / Te Pō / Te Ao Mārama la mieux documentée publiquement, transmise notamment via les whare wānanga, maisons traditionnelles d'enseignement." />
      <InfoCard title="Le Kīlauea, Hawaï" sub="Demeure de Pele" body="Volcan actif dont chaque éruption continue d'être directement associée à la déesse par une partie de la population locale contemporaine." />
      <InfoCard title="Rapa Nui / Île de Pâques" sub="Écriture propre" body="Seule société polynésienne connue à avoir développé une écriture, le rongorongo, restée non déchiffrée à ce jour." />
      <InfoCard title="Tahiti" sub="Tradition de Hiro" body="Foyer de récits propres autour du dieu-navigateur Hiro, dont le nom se retrouve sous forme apparentée dans plusieurs autres traditions du Pacifique central." />
      <InfoCard title="La renaissance culturelle contemporaine" sub="Depuis les années 1970" body="Un mouvement de revitalisation linguistique et culturelle actif à travers plusieurs nations polynésiennes contribue à la transmission renouvelée de ces traditions aux jeunes générations." />
      <InfoCard title="La navigation traditionnelle" sub="Lien direct avec la mythologie" body="Le renouveau de la navigation aux étoiles sans instruments, incarné notamment par le voyage du Hōkūleʻa depuis 1976, s'inscrit directement dans l'héritage des dieux-navigateurs comme Hiro." />
    </div>
  </Section>

  <Section id="frise" label="Frise chronologique" title="Repères historiques">
    <Fragment slot="title"><Decode glyphs="polynesienne">Repères historiques</Decode></Fragment>
    <Timeline items={[
      { year: 'v. 1000-1200 apr. J.-C.', title: 'Peuplement d\'Aotearoa', body: "Les ancêtres du peuple māori atteignent la Nouvelle-Zélande après une navigation océanique de grande ampleur, portant avec eux leurs récits fondateurs." },
      { year: 'Tradition orale, non datée', title: 'Transmission par les whare wānanga', body: "Les maisons d'enseignement traditionnelles māories transmettent la cosmogonie de génération en génération, notamment via l'école de Te Matorohanga." },
      { year: '1840', title: 'Traité de Waitangi', body: "Moment charnière de l'histoire coloniale néo-zélandaise, dont les conséquences pèsent encore aujourd'hui sur la transmission des traditions māories." },
      { year: 'Fin du XIXe siècle', title: 'Premières compilations écrites', body: "Des ethnographes comme Elsdon Best et S. Percy Smith commencent à consigner par écrit des versions de la cosmogonie transmises oralement, non sans risques de déformation." },
      { year: '1976', title: 'Premier voyage du Hōkūleʻa', body: "Cette pirogue double relie Hawaï à Tahiti par navigation traditionnelle sans instruments, relançant l'intérêt public pour les traditions ancestrales du Pacifique." },
      { year: '1987', title: 'Le maori langue officielle en Nouvelle-Zélande', body: "Reconnaissance légale qui accompagne un mouvement plus large de revitalisation culturelle et mythologique." },
      { year: '1998', title: 'Le paradigme Te Ao Mārama', body: "L'universitaire Te Ahukaramū Charles Royal formalise une lecture académique contemporaine de cette séquence cosmologique." },
      { year: 'Depuis les années 2000', title: 'Renaissance culturelle continue', body: "Écoles d'immersion linguistique et programmes culturels renforcent la transmission de ces récits aux nouvelles générations à travers toute la Polynésie." },
    ]} />
  </Section>

  <Section id="heritage" label="Aujourd'hui" title="Ce que cette cosmologie fait encore">
    <Fragment slot="title"><Decode glyphs="polynesienne">Ce que cette cosmologie fait encore</Decode></Fragment>
    <HeritageBlock title="Une croyance activement pratiquée" body="Pele reste invoquée lors des éruptions volcaniques hawaïennes, et les taniwha continuent d'être respectés dans certaines décisions d'aménagement du territoire en Nouvelle-Zélande." />
    <HeritageBlock title="Une renaissance linguistique et culturelle en cours" body="Le mouvement de revitalisation du maori et d'autres langues polynésiennes s'accompagne directement d'une transmission renouvelée de ces récits fondateurs." />
    <HeritageBlock title="Une influence mondiale récente" body="Des œuvres de grande diffusion internationale ont popularisé la figure de Maui bien au-delà du Pacifique, avec un succès qui s'accompagne aussi de débats sur la fidélité de ces représentations aux traditions d'origine." />
    <CautionBox>
      Cette page présente une synthèse à travers plusieurs traditions insulaires distinctes,
      chacune ayant sa propre autorité sur ses propres récits. Elle ne prétend pas trancher entre
      les versions régionales ni les fondre en une seule mythologie polynésienne unifiée qui
      n'a jamais existé comme telle.
    </CautionBox>
  </Section>

