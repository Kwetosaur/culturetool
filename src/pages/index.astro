---
/*
  Les 5 sections de séries sont générées par boucle depuis data/site-pages.json —
  la même source de vérité que tools/sync_sidebar.py (menu latéral des pages
  statiques) et tools/add_page.py. Publier une page = ajouter une entrée dans ce
  JSON ; ni cette page ni le menu ne se patchent plus à la main, et le nombre
  écrit dans le titre d'une section ne peut plus être périmé.

  Une série dont le tableau est vide (ex. "objets" avant sa première page) est
  simplement ignorée ici.
*/
import pages from '../../data/site-pages.json';

const base = import.meta.env.BASE_URL;

const NOMBRES = ['Zéro', 'Une', 'Deux', 'Trois', 'Quatre', 'Cinq', 'Six', 'Sept', 'Huit',
  'Neuf', 'Dix', 'Onze', 'Douze', 'Treize', 'Quatorze', 'Quinze', 'Seize', 'Dix-sept',
  'Dix-huit', 'Dix-neuf', 'Vingt'];
const compte = (n) => NOMBRES[n] || String(n);

const SERIES = [
  {
    key: 'mythologies',
    label: 'Série en cours',
    titre: (n) => `${compte(n)} Mythologies`,
    intro: "Chaque chapitre a sa propre cosmologie, son propre panthéon, son propre décor — le nombre de royaumes ou l'ampleur de la frise varient selon ce que chaque culture porte vraiment, sans moule imposé.",
  },
  {
    key: 'cultures',
    label: 'Série en cours',
    titre: () => 'Cultures du Monde',
    intro: "Des peuples, continents et pays entiers racontés au-delà de leur mythologie : histoire, figures, inventions, style de vie.",
  },
  {
    key: 'creatures',
    label: 'Série en cours',
    titre: () => 'Créatures Légendaires',
    intro: "Entre folklore, fait divers historique et zoologie mystérieuse — ce qu'on sait vraiment, et ce qu'on raconte.",
  },
  {
    key: 'mysteres',
    label: 'Série en cours',
    titre: () => 'Grands Mystères',
    intro: "Lieux, objets et événements non résolus — ou résolus, mais jamais rattrapés par leur légende.",
  },
  {
    key: 'objets',
    label: 'Nouvelle série',
    titre: () => 'Objets Légendaires',
    intro: "Excalibur, le Graal, l'Arche d'Alliance — où s'arrête le récit, et où commence la matière ?",
  },
];

const series = SERIES
  .map((s) => ({ ...s, items: pages[s.key] || [] }))
  .filter((s) => s.items.length > 0);

const total = series.reduce((n, s) => n + s.items.length, 0);

const A_VENIR = [
  { titre: 'Prochaines mythologies', texte: 'Polynésienne, finnoise, cananéenne, coréenne...', tag: 'Mythologies' },
  { titre: 'Prochaines cultures', texte: 'Empire mongol, Inde, Nubie, Al-Andalus...', tag: 'Cultures' },
  { titre: 'Prochaines créatures', texte: 'Les Sirènes, le Loup-Garou, le Wendigo...', tag: 'Créatures' },
  { titre: 'Prochains mystères', texte: "L'Atlantide, le Suaire de Turin, Paititi...", tag: 'Mystères' },
  { titre: 'Prochains objets légendaires', texte: 'La Toison d\'Or, la Boîte de Pandore, la Pierre de Scone...', tag: 'Objets' },
];

const description = "Une encyclopédie illustrée des mythologies, cultures, créatures, mystères et objets légendaires du monde — cosmogonies, panthéons, enquêtes et héritages, culture par culture.";
const pageUrl = new URL(base, Astro.site).href;
---

<!doctype html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Mythologies & Cultures du Monde</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="Mythologies & Cultures du Monde" />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={pageUrl} />
  <meta property="og:image" content={new URL(`${base}map.jpg`, Astro.site).href} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@700;900&family=Cinzel:wght@400;600;700&family=EB+Garamond:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #10131c;
      --bg-deep: #0a0c13;
      --panel: #171b28;
      --panel-border: #2a2f42;
      --gold: #c9982f;
      --gold-bright: #e8c164;
      --text: #e9e6db;
      --text-dim: #9a9bb0;
      --glow: rgba(201, 152, 47, 0.25);
    }
    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background:
        radial-gradient(ellipse at top, #1a1f30 0%, var(--bg) 55%),
        var(--bg-deep);
      color: var(--text);
      font-family: 'EB Garamond', Georgia, serif;
      font-size: 18px;
      line-height: 1.7;
    }
    h1, h2, h3 { font-family: 'Cinzel', serif; color: var(--gold-bright); letter-spacing: 0.03em; }
    a { color: var(--gold-bright); }

    header.hero {
      text-align: center;
      padding: 100px 20px 70px;
      max-width: 900px;
      margin: 0 auto;
    }
    .kicker {
      font-family: 'Cinzel', serif;
      letter-spacing: 0.35em;
      font-size: 0.8rem;
      color: var(--gold);
      text-transform: uppercase;
    }
    h1.title {
      font-family: 'Cinzel Decorative', serif;
      font-size: clamp(2.2rem, 6vw, 3.6rem);
      margin: 18px 0 10px;
      text-shadow: 0 0 40px var(--glow);
    }
    .tagline {
      font-size: 1.15rem;
      color: var(--text-dim);
      font-style: italic;
      max-width: 640px;
      margin: 0 auto;
    }
    .divider {
      width: 120px;
      height: 2px;
      margin: 34px auto;
      background: linear-gradient(90deg, transparent, var(--gold), transparent);
    }
    .map-link {
      display: inline-block;
      margin-top: 30px;
      padding: 10px 22px;
      border: 1px solid var(--panel-border);
      border-radius: 6px;
      font-family: 'Cinzel', serif;
      font-size: 0.85rem;
      letter-spacing: 0.04em;
      text-decoration: none;
      color: var(--text);
      transition: border-color 0.2s ease, color 0.2s ease;
    }
    .map-link:hover { border-color: var(--gold); color: var(--gold-bright); }

    section { max-width: 1180px; margin: 0 auto; padding: 40px 24px 90px; }
    .section-label {
      font-family: 'Cinzel', serif;
      letter-spacing: 0.25em;
      font-size: 0.75rem;
      color: var(--gold);
      text-transform: uppercase;
      text-align: center;
      margin-bottom: 8px;
    }
    h2.section-title { text-align: center; font-size: 1.9rem; margin: 0 0 14px; }
    p.section-intro {
      text-align: center;
      color: var(--text-dim);
      max-width: 640px;
      margin: 0 auto 50px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 22px;
    }
    .card {
      display: block;
      text-decoration: none;
      background: linear-gradient(160deg, var(--panel), var(--bg-deep));
      border: 1px solid var(--panel-border);
      border-radius: 6px;
      padding: 26px 24px;
      transition: transform 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
    }
    .card:hover {
      transform: translateY(-4px);
      border-color: var(--gold);
      box-shadow: 0 10px 30px rgba(0,0,0,0.4);
    }
    .card .epigraph { font-size: 0.85rem; color: var(--gold); letter-spacing: 0.15em; margin-bottom: 10px; }
    .card h3 { margin: 0 0 8px; font-size: 1.3rem; color: var(--text); }
    .card p { margin: 0; color: var(--text-dim); font-size: 0.95rem; }

    .placeholder-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 18px;
    }
    .placeholder-card {
      border: 1px dashed var(--panel-border);
      border-radius: 6px;
      padding: 22px 20px;
      color: var(--text-dim);
      background: rgba(255,255,255,0.02);
    }
    .placeholder-card h4 { margin: 0 0 6px; color: var(--text-dim); font-family: 'Cinzel', serif; font-size: 1.05rem; }
    .placeholder-card span.tag {
      display: inline-block;
      font-size: 0.7rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold);
      border: 1px solid var(--panel-border);
      border-radius: 3px;
      padding: 2px 8px;
      margin-top: 10px;
    }

    footer {
      text-align: center;
      padding: 50px 20px 80px;
      color: var(--text-dim);
      font-size: 0.9rem;
    }

    @media (max-width: 640px) {
      header.hero { padding: 70px 18px 50px; }
      section { padding: 20px 18px 60px; }
    }
  </style>
</head>
<body data-egg="accueil">
  <header class="hero">
    <div class="kicker">Encyclopédie illustrée</div>
    <h1 class="title">Mythologies &amp; Cultures du Monde</h1>
    <div class="divider"></div>
    <p class="tagline">Cosmogonies, panthéons, généalogies, créatures, légendes, frises et héritages — une traversée culture par culture, chacune racontée à sa juste mesure.</p>
    <a href={`${base}map.html`} class="map-link">🗺️ Voir la carte du monde</a>
  </header>

  {series.map((s) => (
    <section id={s.key}>
      <div class="section-label">{s.label}</div>
      <h2 class="section-title">{s.titre(s.items.length)}</h2>
      <p class="section-intro">{s.intro}</p>
      <div class="grid">
        {s.items.map((p) => (
          <a class="card" href={`${base}${p.href}`}>
            <div class="epigraph">{p.epigraph}</div>
            <h3>{p.cardTitle || p.title}</h3>
            <p>{p.hook}</p>
          </a>
        ))}
      </div>
    </section>
  ))}

  <section id="a-venir">
    <div class="section-label">Bientôt</div>
    <h2 class="section-title">La Suite</h2>
    <p class="section-intro">{total} pages en ligne, et toutes les séries s'étoffent une entrée à la fois, au rythme des crédits du jour.</p>
    <div class="placeholder-grid">
      {A_VENIR.map((a) => (
        <div class="placeholder-card">
          <h4>{a.titre}</h4>
          <p>{a.texte}</p>
          <span class="tag">{a.tag}</span>
        </div>
      ))}
    </div>
  </section>

  <footer>
    Site personnel — mythologies et cultures du monde.
  </footer>
  <script src={`${base}effects.js`} defer></script>
</body>
</html>
