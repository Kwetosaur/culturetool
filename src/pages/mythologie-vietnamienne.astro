    <Fragment slot="title"><Decode glyphs="chine">Repères historiques</Decode></Fragment>
    <Timeline items={[
      { year: 'v. 1000-1 av. J.-C.', title: 'Culture de Đông Sơn', body: "Civilisation du bronze qui offre le meilleur ancrage archéologique connu derrière la légende des rois Hùng." },
      { year: '257 av. J.-C. (traditionnel)', title: 'Fondation légendaire de Âu Lạc', body: "An Dương Vương succède aux rois Hùng et reçoit l'arbalète magique du Dieu Tortue d'Or, selon la chronologie traditionnelle." },
      { year: '40 apr. J.-C.', title: 'Révolte des Sœurs Trưng', body: "Soulèvement historiquement attesté contre l'occupation Han, devenu l'un des grands récits de résistance nationale." },
      { year: '1428', title: 'Lê Lợi et l\'épée restituée', body: "Selon la légende, la grande tortue du lac Hoàn Kiếm reprend l'épée magique une fois l'indépendance recouvrée." },
      { year: '1479', title: 'Chronique de Ngô Sĩ Liên', body: "Première grande compilation écrite qui fixe par écrit, et date rétrospectivement, la légende des rois Hùng dans l'histoire officielle du royaume." },
      { year: '2010', title: 'Festival de Thánh Gióng reconnu par l\'UNESCO', body: "Inscription au patrimoine culturel immatériel de l'humanité." },
      { year: '2012', title: 'Culte des rois Hùng reconnu par l\'UNESCO', body: "Le pèlerinage annuel de Đền Hùng rejoint à son tour le patrimoine immatériel mondial." },
      { year: '2016', title: 'Đạo Mẫu reconnu par l\'UNESCO', body: "Le culte des Déesses-Mères centré sur Liễu Hạnh obtient à son tour cette reconnaissance internationale." },
      { year: '2016', title: 'Mort de Cụ Rùa', body: "La grande tortue du lac Hoàn Kiếm, longtemps identifiée à la figure légendaire du Dieu Tortue, meurt dans le lac lui-même — un événement suivi avec une émotion nationale sincère." },
      { year: 'Aujourd\'hui', title: 'Un jour férié national', body: "Le jour de commémoration des rois Hùng reste un jour chômé officiel au Vietnam, mythe fondateur transformé en calendrier civil." },
