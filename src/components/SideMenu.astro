---
/*
  SideMenu.astro — le menu lateral (hamburger + recherche + groupes) partage
  par PageLayout.astro ET par les pages autonomes hors socle (index.astro,
  chronologie-mondiale.astro) qui n'utilisent pas PageLayout mais doivent
  quand meme rester navigables vers le reste du site.

  Extrait de PageLayout.astro le 29/07/2026 pour eviter une 3e copie manuelle
  du meme bloc (markup + CSS + script) a chaque nouvelle page hors-serie.
  Le CSS est duplique ici (pas importe de tokens.css) : les pages autonomes
  n'importent pas tokens.css, donc le composant doit etre auto-suffisant.

  IMPORTANT zoom : #side-menu-toggle/-overlay/-menu portent zoom:0.6667 pour
  annuler le zoom:1.5 de confort de lecture pose sur <body> (cf. audit du
  26/07 "exclut la chrome fixe du zoom de confort"). Toute page qui inclut ce
  composant doit donc AUSSI avoir `zoom:1.5` sur son body, sans quoi le menu
  s'affiche minuscule (1.5 * 0.6667 ~= 1, mais 1 * 0.6667 = trop petit).
*/
import pages from '../../data/site-pages.json';

export interface Props {
  /** href de la page courante (pour marquer le lien actif) ; absent sur les
      pages hors-serie (index, chronologie) qui n'apparaissent pas dans les groupes. */
  activeHref?: string;
}
const { activeHref = '' } = Astro.props;

const SIDE_GROUPS = [
  ['Mythologies', 'mythologies'],
  ['Cultures', 'cultures'],
  ['Créatures', 'creatures'],
  ['Mystères', 'mysteres'],
  ['Objets légendaires', 'objets'],
];
const groups = SIDE_GROUPS
  .map(([label, key]) => [label, pages[key] || []])
  .filter(([, items]) => items.length > 0);
---
<button id="side-menu-toggle" aria-label="Ouvrir le menu">&#9776;</button>
<div id="side-menu-overlay"></div>
<nav id="side-menu">
  <a href="./" class="side-home">&larr; Accueil</a>
  <a href="map.html" class="side-home">&#128506; Carte du Monde</a>
  <a href="chronologie-mondiale.html" class="side-home">&#8987; Chronologie Mondiale</a>
  <div class="side-divider"></div>
  <div class="side-search"><input type="text" id="side-search-input" placeholder="Rechercher une page..." autocomplete="off" /></div>
  {groups.map(([label, items]) => (
    <Fragment>
      <div class="side-label">{label}</div>
      <div class="side-group">
        {items.map((p) => (
          <a href={p.href} class={p.href === activeHref ? 'active' : undefined}>{p.title}</a>
        ))}
      </div>
    </Fragment>
  ))}
</nav>

<style>
  #side-menu-toggle{position:fixed; zoom:0.6667; top:18px; left:18px; z-index:9999; width:44px; height:44px; border-radius:8px; border:1px solid rgba(255,255,255,0.18); background:rgba(10,10,15,0.72); backdrop-filter:blur(6px); color:#e9e6db; font-size:20px; line-height:1; cursor:pointer; display:flex; align-items:center; justify-content:center;}
  #side-menu-toggle:hover{background:rgba(10,10,15,0.9); border-color:#c9982f;}
  #side-menu-overlay{position:fixed; zoom:0.6667; inset:0; background:rgba(0,0,0,0.45); z-index:9997; opacity:0; pointer-events:none; transition:opacity 0.2s ease;}
  #side-menu-overlay.open{opacity:1; pointer-events:auto;}
  #side-menu{position:fixed; zoom:0.6667; top:0; left:0; height:100vh; width:270px; max-width:82vw; background:rgba(12,12,18,0.97); backdrop-filter:blur(8px); z-index:9998; transform:translateX(-100%); transition:transform 0.25s ease; box-shadow:2px 0 24px rgba(0,0,0,0.4); overflow-y:auto; padding:70px 0 30px; font-family:'EB Garamond', Georgia, serif;}
  #side-menu.open{transform:translateX(0);}
  #side-menu a{display:block; padding:9px 22px; color:#cfd0dd; text-decoration:none; font-size:0.98rem; border-left:3px solid transparent;}
  #side-menu a:hover{background:rgba(255,255,255,0.06); color:#f2e9d0;}
  #side-menu a.active{color:#e8c164; border-left-color:#c9982f; font-weight:600;}
  #side-menu a.search-hide{display:none;}
  #side-menu .side-home{margin:0 14px 14px; padding:12px 16px !important; border:1px solid rgba(255,255,255,0.18); border-radius:6px; text-align:center; font-family:'Cinzel', serif; letter-spacing:0.05em; font-size:0.85rem; text-transform:uppercase;}
  #side-menu .side-divider{margin:6px 22px 10px; height:1px; background:rgba(255,255,255,0.12);}
  #side-menu .side-search{padding:0 22px 14px;}
  #side-menu .side-search input{width:100%; box-sizing:border-box; padding:8px 10px; background:rgba(255,255,255,0.06); border:1px solid rgba(255,255,255,0.16); border-radius:5px; color:#e9e6db; font-family:'EB Garamond', Georgia, serif; font-size:0.9rem;}
  #side-menu .side-search input::placeholder{color:#7a7b8c;}
  #side-menu .side-search input:focus{outline:none; border-color:#c9982f;}
  #side-menu .side-label{padding:12px 22px 6px; margin-top:2px; font-family:'Cinzel', serif; font-size:0.68rem; letter-spacing:0.2em; text-transform:uppercase; color:#8b8ca0; cursor:pointer; user-select:none; display:flex; align-items:center; justify-content:space-between;}
  #side-menu .side-label::after{content:'\25BE'; font-size:0.65rem; transition:transform 0.2s ease; color:#6d6e7e;}
  #side-menu .side-label.collapsed::after{transform:rotate(-90deg);}
  #side-menu .side-group{overflow:hidden; max-height:3000px; transition:max-height 0.25s ease;}
  #side-menu .side-group.collapsed{max-height:0;}
</style>

<script is:inline>
/* Menu lateral : ouverture, replis par groupe, recherche.
   Identique au script de PageLayout.astro — a garder aligne si l'un des deux evolue. */
(function () {
  var menu = document.getElementById('side-menu');
  var overlay = document.getElementById('side-menu-overlay');
  var toggle = document.getElementById('side-menu-toggle');
  if (!menu || !overlay || !toggle) return;
  toggle.addEventListener('click', function () {
    menu.classList.toggle('open');
    overlay.classList.toggle('open');
  });
  overlay.addEventListener('click', function () {
    menu.classList.remove('open');
    overlay.classList.remove('open');
  });

  var labels = Array.prototype.slice.call(menu.querySelectorAll('.side-label'));
  labels.forEach(function (label) {
    var group = label.nextElementSibling;
    if (!group) return;
    if (!group.querySelector('a.active')) {
      label.classList.add('collapsed');
      group.classList.add('collapsed');
    }
    label.addEventListener('click', function () {
      label.classList.toggle('collapsed');
      group.classList.toggle('collapsed');
    });
  });

  var input = document.getElementById('side-search-input');
  if (!input) return;
  var links = Array.prototype.slice.call(menu.querySelectorAll('.side-group a'));
  function restoreCollapse() {
    labels.forEach(function (label) {
      var group = label.nextElementSibling;
      if (!group) return;
      var hasActive = !!group.querySelector('a.active');
      label.classList.toggle('collapsed', !hasActive);
      group.classList.toggle('collapsed', !hasActive);
    });
  }
  input.addEventListener('input', function () {
    var q = input.value.trim().toLowerCase();
    if (!q) {
      links.forEach(function (a) { a.classList.remove('search-hide'); });
      restoreCollapse();
      return;
    }
    links.forEach(function (a) {
      a.classList.toggle('search-hide', a.textContent.toLowerCase().indexOf(q) === -1);
    });
    labels.forEach(function (label) {
      label.classList.remove('collapsed');
      if (label.nextElementSibling) label.nextElementSibling.classList.remove('collapsed');
    });
  });
  input.addEventListener('keydown', function (e) {
    if (e.key !== 'Enter') return;
    var first = links.filter(function (a) { return !a.classList.contains('search-hide'); })[0];
    if (first) window.location.href = first.getAttribute('href');
  });
})();
</script>
